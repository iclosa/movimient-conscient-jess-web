---
import { ui } from '../i18n/ui';
import { sectionPath, type Lang } from '../i18n/routes';
const { lang } = Astro.props as { lang: Lang };
const t = ui[lang];
---
<section class="section">
  <div class="wrap">
    <div class="band">
      <h2>{t.cta.title}</h2>
      <p>{t.cta.text}</p>
      <div class="actions">
        <a class="btn light" href={sectionPath(lang, 'app')}>{t.cta.book}</a>
        <a class="btn alt" href={sectionPath(lang, 'contact')}>{t.cta.contact}</a>
      </div>
    </div>
  </div>
</section>
