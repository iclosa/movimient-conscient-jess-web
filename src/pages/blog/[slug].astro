---
import C from '../../components/Post.astro';
import NotFound from '../../components/NotFound.astro';
import { loadPosts } from '../../lib/content';
const item = (await loadPosts()).find((p) => p.translations.ca.slug === Astro.params.slug);
if (!item) Astro.response.status = 404;
---
{item ? <C lang="ca" id={item.id} /> : <NotFound lang="ca" />}
