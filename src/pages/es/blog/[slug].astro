---
import C from '../../../components/Post.astro';
import { loadPosts } from '../../../lib/content';
export async function getStaticPaths() {
  return (await loadPosts()).map((x) => ({ params: { slug: x.translations.es.slug }, props: { id: x.id } }));
}
const { id } = Astro.props;
---
<C lang="es" id={id} />
