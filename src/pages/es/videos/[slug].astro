---
import C from '../../../components/Video.astro';
import NotFound from '../../../components/NotFound.astro';
import { freeVideos } from '../../../data/videos';
const item = (await freeVideos()).find((v) => v.slug.es === Astro.params.slug);
if (!item) Astro.response.status = 404;
---
{item ? <C lang="es" id={item.id} /> : <NotFound lang="es" />}
