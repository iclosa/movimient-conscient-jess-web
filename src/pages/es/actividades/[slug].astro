---
import C from '../../../components/Activity.astro';
import NotFound from '../../../components/NotFound.astro';
import { loadActivities } from '../../../data/activities';
const item = (await loadActivities()).find((a) => a.slug.es === Astro.params.slug);
if (!item) Astro.response.status = 404;
---
{item ? <C lang="es" id={item.id} /> : <NotFound lang="es" />}
