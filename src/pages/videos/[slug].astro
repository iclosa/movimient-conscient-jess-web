---
import C from '../../components/Video.astro';
import NotFound from '../../components/NotFound.astro';
import { freeVideos } from '../../data/videos';
const item = (await freeVideos()).find((v) => v.slug.ca === Astro.params.slug);
if (!item) Astro.response.status = 404;
---
{item ? <C lang="ca" id={item.id} /> : <NotFound lang="ca" />}
